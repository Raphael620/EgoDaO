{
  "recording": {
    "data_root": "./Data",
    "raw_subdir": "Raw",
    "humanego_subdir": "HumanEgo",
    "video_codec": "mp4v",
    "video_backend": "opencv",
    "hw_encoder": "h264_qsv",
    "enable_raw": true,
    "enable_humanego": false,
    "disk_keep_days": 3
  },
  "camera": {
    "resolution": [1280, 800],
    "fps": 30
  },
  "imu": {
    "accel_rate_hz": 200,
    "gyro_rate_hz": 200,
    "batch_threshold": 1,
    "max_batch_reports": 20
  },
  "app": {
    "enable_vio": true,
    "enable_hand_tracking": true,
    "hand_tracker_backend": "mediapipe"
  }
}
